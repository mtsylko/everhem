# The store's .myshopify.com domain.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Option 1: a Dev Dashboard app from the same organization as the store.
# The seeder exchanges these for a 24-hour access token on each run.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Option 2: an Admin API access token. Used instead of the client credentials when set.
SHOPIFY_ADMIN_TOKEN=

# Optional. LOG_FORMAT is json or pretty (pretty in a terminal by default).
# LOG_FORMAT=pretty
# LOG_LEVEL=info
