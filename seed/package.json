{
  "name": "@everhem/seed",
  "private": true,
  "type": "module",
  "description": "Seeds the Everhem demo store through the Shopify Admin GraphQL API",
  "scripts": {
    "seed": "node --env-file-if-exists=.env src/cli.ts seed",
    "teardown": "node --env-file-if-exists=.env src/cli.ts teardown",
    "codegen": "graphql-codegen",
    "placeholders": "node scripts/render-placeholders.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@shopify/admin-api-client": "^2.0.1"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^3.0.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
