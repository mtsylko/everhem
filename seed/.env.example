# The store's .myshopify.com domain.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Option 1: a Dev Dashboard app from the same organization as the store.
# The seeder exchanges these for a 24-hour access token on each run.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Option 2: an Admin API access token. Used instead of the client credentials when set.
SHOPIFY_ADMIN_TOKEN=

# Optional. Where the storefront is deployed, e.g. https://plainweft.vercel.app. When set, the seeder
# subscribes the storefront's /api/revalidate to product, collection and stock changes, so an edit
# in the admin reaches the site at once. Shopify only calls https:// addresses.
# STOREFRONT_URL=

# Optional. LOG_FORMAT is json or pretty (pretty in a terminal by default).
# LOG_FORMAT=pretty
# LOG_LEVEL=info
