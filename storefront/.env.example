# The store's .myshopify.com domain.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# The private Storefront API token from the Headless channel (Storefront API > Private access token).
# It stays on the server: every Storefront API request is made by Next.js, never by the browser.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# The client secret of the app that subscribed the webhooks: the seed's SHOPIFY_CLIENT_SECRET.
# Shopify signs each webhook with it, and /api/revalidate turns away any request it didn't sign.
SHOPIFY_WEBHOOK_SECRET=

# Where the store is deployed, e.g. https://everhem.vercel.app. hreflang links, the sitemap,
# robots.txt and shared images use absolute URLs built from it. Defaults to http://localhost:3000.
SITE_URL=
